# Copy to .env for local overrides. Every value is optional locally.

# PostgreSQL connection string. Leave unset locally to use PGlite (stored in ./.pglite).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port the API listens on. The web app runs on 3000.
# PORT=3001

# Comma-separated list of sites allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:3000

# Number of proxies in front of the API on the host (usually 1). 0 locally.
# TRUST_PROXY_HOPS=0

# Email alert for each new message (Resend). Leave unset locally to skip emails.
# CONTACT_NOTIFY_TO must be the email address of the Resend account while using its test sender.
# RESEND_API_KEY=re_...
# CONTACT_NOTIFY_TO=you@example.com
# CONTACT_NOTIFY_FROM=Portfolio <onboarding@resend.dev>
