# Copy to .env.local for local overrides. Every value here ends up in the browser code
# (that's what the NEXT_PUBLIC_ prefix means), so never put secrets in this file.

# Base URL of the contact API (apps/api). Defaults to http://localhost:3001.
# NEXT_PUBLIC_API_URL=https://your-api-host.example

# PostHog project API key (starts with phc_; public by design) and its region's host.
# Leave unset to switch PostHog off.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID (starts with G-). Leave unset to switch GA off
# (the cookie consent bar only appears when this is set).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
